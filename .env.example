# =========================================================================
# STUDYTOGETHER CONFIGURATION TEMPLATE (.env.example)
# =========================================================================
# This file lists all environment variables required by the StudyTogether 
# application. Copy this file to your local development environment:
# - For Backend: Copy into "server/.env"
# - For Frontend: Copy into "client/.env" (Only VITE_API_URL is needed)
# =========================================================================

# -------------------------------------------------------------------------
# BACKEND CONFIGURATION (server/.env)
# -------------------------------------------------------------------------

# Server running port
PORT=5000

# Node execution environment (development, production)
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/studytogether

# Secret key used for signing JWT access tokens (15-minute lifetime)
JWT_SECRET=your_jwt_access_token_secret_key_here

# Secret key used for signing JWT refresh tokens (7-day lifetime)
JWT_REFRESH_SECRET=your_jwt_refresh_token_secret_key_here

# Shared secret for backend-to-AI microservice internal communication
INTERNAL_SERVICE_KEY=your_internal_service_key_secret_here

# Client application URL (for CORS access control)
CLIENT_URL=http://localhost:5173

# Cloudinary credentials for raw PDF storage uploads
CLOUD_NAME=your_cloudinary_cloud_name_here
API_KEY=your_cloudinary_api_key_here
API_SECRET=your_cloudinary_api_secret_here

# Razorpay credentials for payment gateway transactions checkout
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_signature_secret_here

# -------------------------------------------------------------------------
# FRONTEND CONFIGURATION (client/.env)
# -------------------------------------------------------------------------

# Backend server API root url (with versioning prefix)
VITE_API_URL=http://localhost:5000/api/v1

# -------------------------------------------------------------------------
# AI MICROSERVICE CONFIGURATION (ai/.env or root .env)
# -------------------------------------------------------------------------

# AI Microservice Port
AI_PORT=5001

# AI Microservice URL (used by backend for internal calls)
AI_SERVICE_URL=http://localhost:5001

# Ollama Local Service Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
